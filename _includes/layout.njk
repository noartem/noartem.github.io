{% if langCode == "ru" %}
  {% set L = { person: ru.person, projects: projects, strings: ru.strings } %}
{% else %}
  {% set L = { person: person, projects: projects, strings: strings } %}
{% endif %}
{% set t = L.strings %}
{% set contacts = L.person.contacts %}
{% set contactOrder = ["email", "github", "linkedin", "telegram", "x"] %}
<!doctype html>
<html lang="{{ langCode }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ L.person.name }} — {{ L.person.role }}" />
    <title>{{ siteTitle }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Serif:wght@400;700&display=optional"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="icon" href="{{ '/assets/favicon.ico' | url }}" />
    <script>
      // Flash prevention: the page is opened scrolled or on a section anchor
      // (/#projects, /#bucket) — render the compact bar immediately, no unroll flash.
      // window.scrollY is still 0 while <head> parses (the hash jump happens later),
      // so the hash itself is the reliable signal.
      if (window.scrollY > 100 || location.hash) {
        var d = document.documentElement;
        d.style.setProperty("--p", "1");
        d.classList.add("compact");
      }
    </script>
    <script>
      // Theme flash prevention: resolve the stored mode before first paint.
      // "system" (the default) leaves the attribute unset — light default CSS.
      try {
        var t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") t = "system";
        if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="head-box">
          <div class="head-row">
            <div class="head-avatar">
              <img
                src="/assets/profile.jpg"
                alt="{{ t.portraitAlt }}"
                class="head-avatar-img"
                width="640"
                height="960"
              />
            </div>
            <div class="head-id">
              <h1 class="head-name">{{ L.person.name }}</h1>
              <p class="head-role">{{ L.person.role | markdownInline | safe }}</p>
              <ul class="contact-list">
                {% if contacts %}
                  {% for key in contactOrder %}
                    {% set value = contacts[key] %}
                    {% if value %}
                      <li>
                        {% if key == "email" %}
                          <a href="mailto:{{ value }}" class="contact-icon" aria-label="Email">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"/></svg>
                            <span class="contact-label">Email</span>
                          </a>
                        {% elseif key == "github" %}
                          <a href="https://github.com/{{ value }}" class="contact-icon" aria-label="GitHub">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                            <span class="contact-label">GitHub</span>
                          </a>
                        {% elseif key == "linkedin" %}
                          <a href="https://www.linkedin.com/in/{{ value }}" class="contact-icon" aria-label="LinkedIn">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            <span class="contact-label">LinkedIn</span>
                          </a>
                        {% elseif key == "x" %}
                          <a href="https://x.com/{{ value }}" class="contact-icon" aria-label="Twitter/X">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
                            <span class="contact-label">Twitter/X</span>
                          </a>
                        {% elseif key == "telegram" %}
                          <a href="https://t.me/{{ value }}" class="contact-icon" aria-label="Telegram">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                            <span class="contact-label">Telegram</span>
                          </a>
                        {% endif %}
                      </li>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </ul>
            </div>
            <div class="head-side">
              <div class="lang-switch" role="group" aria-label="{{ t.langGroupLabel }}">
                <a
                  href="/"
                  class="lang{% if langCode == 'en' %} active{% endif %}"
                  lang="en"
                  aria-label="English"
                  {% if langCode == 'en' %}aria-current="true"{% endif %}
                  ><svg class="flag" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><g fill="#B22234"><rect y="0" width="30" height="1.54"/><rect y="3.08" width="30" height="1.54"/><rect y="6.15" width="30" height="1.54"/><rect y="9.23" width="30" height="1.54"/><rect y="12.31" width="30" height="1.54"/><rect y="15.38" width="30" height="1.54"/><rect y="18.46" width="30" height="1.54"/></g><rect width="12" height="7.7" fill="#3C3B6E"/></svg></a
                >
                <a
                  href="/ru/"
                  class="lang{% if langCode == 'ru' %} active{% endif %}"
                  lang="ru"
                  aria-label="Русский"
                  {% if langCode == 'ru' %}aria-current="true"{% endif %}
                  ><svg class="flag" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="6.67" fill="#fff"/><rect y="6.67" width="30" height="6.67" fill="#0039A6"/><rect y="13.33" width="30" height="6.67" fill="#D52B1E"/></svg></a
                >
              </div>
              <div class="theme-switch" role="group" aria-label="{{ t.themeGroupLabel }}">
                <button type="button" class="theme-opt" data-theme-option="light" aria-pressed="false" title="{{ t.themeLight }}" aria-label="{{ t.themeLight }}"><span aria-hidden="true">☀️</span></button>
                <button type="button" class="theme-opt" data-theme-option="dark" aria-pressed="false" title="{{ t.themeDark }}" aria-label="{{ t.themeDark }}"><span aria-hidden="true">🌙</span></button>
                <button type="button" class="theme-opt" data-theme-option="system" aria-pressed="false" title="{{ t.themeSystem }}" aria-label="{{ t.themeSystem }}"><span aria-hidden="true">🖥️</span></button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <main>
        <section class="section" id="projects">
          <h2>{{ t.projects }}</h2>
          <table class="portfolio-table">
            <thead>
              <tr>
                <th>{{ t.projectsHeader.name }}</th>
                <th>{{ t.projectsHeader.stack }}</th>
                <th>{{ t.projectsHeader.description }}</th>
              </tr>
            </thead>
            <tbody>
              {% for project in L.projects %}
              <tr>
                <td>
                  <a href="{{ project.url }}">{{ project.name }}</a>
                  {% if project.demo %}
                    <span>
                      · <a href="{{ project.demo }}">Demo</a>
                    </span>
                  {% endif %}
                </td>
                <td>
                  {% if project.stack %}
                    {{ project.stack | join(", ") }}
                  {% endif %}
                </td>
                <td>
                  {% if project.description %}
                    {{ project.description | markdownInline | safe }}
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </section>

        <section class="section" id="bucket">
          <h2>{{ t.bucket }}</h2>
          <p>{{ t.bucketIntro | safe }}</p>
          <table class="portfolio-table">
            <thead>
              <tr>
                <th>{{ t.bucketHeader.app }}</th>
                <th>{{ t.bucketHeader.version }}</th>
                <th>{{ t.bucketHeader.license }}</th>
                <th>{{ t.bucketHeader.description }}</th>
              </tr>
            </thead>
            <tbody>
              {% include "bucket-rows.njk" %}
            </tbody>
          </table>
        </section>
      </main>
    </div>
    <script src="/assets/site.js?v=5" defer></script>
  </body>
</html>
